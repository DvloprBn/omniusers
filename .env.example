# Copia este archivo a ".env" y rellena valores reales.
# ".env" NUNCA debe subirse a git (ya está en .gitignore).
# Genera secretos con: openssl rand -base64 24

# --- PostgreSQL (omniuser_db) ---
POSTGRES_USER=omniuser_user
POSTGRES_PASSWORD=
POSTGRES_DB=omniuser_db
DATABASE_URL=postgresql://omniuser_user:CONTRASEÑA_AQUI@omniuser_db:5432/omniuser_db

# --- Redis (omniuser_redis) ---
REDIS_PASSWORD=

# --- Auth (JWT) ---
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- 2FA (cifrado del secreto TOTP en reposo) ---
# EXACTAMENTE 32 bytes en hex (64 caracteres) — genera con: openssl rand -hex 32
# Nunca el mismo valor que JWT_SECRET (responsabilidades distintas — ver
# common/utils/crypto.util.ts).
TOTP_ENCRYPTION_KEY=

# --- Correo (Resend) ---
# Sin dominio propio verificado todavía, usa el remitente de pruebas de
# Resend (onboarding@resend.dev) — manda correos REALES, no un simulacro,
# pero solo a la cuenta dueña de la API key hasta verificar un dominio.
RESEND_API_KEY=
# MAIL_FROM_ADDRESS=no-reply@tu-dominio-real.com

# --- Producción únicamente (dev no las usa) ---
# NODE_ENV=production
# DOMAIN=tu-dominio-real.com
