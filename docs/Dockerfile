# Extiende la imagen oficial de MkDocs Material agregando el plugin que
# renderiza Swagger UI dentro de una página Markdown normal — instalado en
# BUILD (una sola vez), no con 'pip install' en cada arranque del contenedor.
# Mismo patrón real ya probado en Dely Doggy.
FROM squidfunk/mkdocs-material:9.5
RUN pip install mkdocs-swagger-ui-tag
